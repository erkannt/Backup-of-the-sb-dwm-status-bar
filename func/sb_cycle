# Prints the current ISO Week, quarter, cycle and cycle week to stdout
# The 52 weeks of the year are divided into four _quarters_ of 13 weeks.
# Each quarter has three _cycles_ of four weeks and ends with a _reset_ week.

cycle() {
        local iso_week=$(date +%V)
        local quarter=$(( (iso_week - 1) / 13 + 1 ))
        local cycle=$(( (iso_week - 1) % 13 / 4 + 1 ))
        local cycle_week=$(( (iso_week - 1) % 4 + 1 ))

        if [ "$cycle" -eq 4 ]; then
                printf '%02d-%d/reset' "$iso_week" "$quarter"
        else
                printf '%02d-%d/%d/%d' "$iso_week" "$quarter" "$cycle" "$cycle_week"
        fi

        printf ' %s ' "$DELIMITER"
}
